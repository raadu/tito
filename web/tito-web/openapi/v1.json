{
  "openapi": "3.1.1",
  "info": {
    "title": "Tito.Api | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/api/employees/today": {
      "get": {
        "tags": [
          "Employees"
        ],
        "summary": "Every known employee with today's status (Absent / Working / Done) for the /list board.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TodayBoardResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/attendance/status": {
      "get": {
        "tags": [
          "Attendance"
        ],
        "summary": "Today's status for an employee: decides whether the button says Time In or Time Out.",
        "parameters": [
          {
            "name": "employeeCode",
            "in": "query",
            "description": "The employee ID typed on the home screen.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "fullName",
            "in": "query",
            "description": "The full name typed on the home screen.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AttendanceStatusResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/attendance/time-in": {
      "post": {
        "tags": [
          "Attendance"
        ],
        "summary": "Records Time In for today.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AttendanceRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/AttendanceRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/AttendanceRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AttendanceStatusResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/attendance/time-out": {
      "post": {
        "tags": [
          "Attendance"
        ],
        "summary": "Records Time Out for today. Requires a Time In first.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AttendanceRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/AttendanceRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/AttendanceRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AttendanceStatusResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AttendanceRequest": {
        "required": [
          "employeeCode",
          "fullName",
          "date",
          "comment"
        ],
        "type": "object",
        "properties": {
          "employeeCode": {
            "type": "string"
          },
          "fullName": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "comment": {
            "type": [
              "null",
              "string"
            ]
          }
        },
        "additionalProperties": false,
        "description": "Body for both POST /time-in and POST /time-out."
      },
      "AttendanceStatus": {
        "enum": [
          "Absent",
          "Working",
          "Done"
        ]
      },
      "AttendanceStatusResponse": {
        "required": [
          "employeeCode",
          "fullName",
          "status",
          "today",
          "timeInUtc",
          "timeInComment",
          "timeOutUtc",
          "timeOutComment",
          "workedMinutes",
          "serverNowUtc"
        ],
        "type": "object",
        "properties": {
          "employeeCode": {
            "type": "string"
          },
          "fullName": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "$ref": "#/components/schemas/AttendanceStatus"
          },
          "today": {
            "type": "string",
            "format": "date"
          },
          "timeInUtc": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "timeInComment": {
            "type": [
              "null",
              "string"
            ]
          },
          "timeOutUtc": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "timeOutComment": {
            "type": [
              "null",
              "string"
            ]
          },
          "workedMinutes": {
            "type": "integer",
            "format": "int32"
          },
          "serverNowUtc": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false,
        "description": "One employee's state for today. Drives the Time In / Time Out button."
      },
      "EmployeeTodayResponse": {
        "required": [
          "employeeCode",
          "fullName",
          "status",
          "timeInUtc",
          "timeOutUtc",
          "workedMinutes"
        ],
        "type": "object",
        "properties": {
          "employeeCode": {
            "type": "string"
          },
          "fullName": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/AttendanceStatus"
          },
          "timeInUtc": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "timeOutUtc": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "workedMinutes": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false,
        "description": "One row on the /list status board."
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        },
        "additionalProperties": false
      },
      "TodayBoardResponse": {
        "required": [
          "today",
          "serverNowUtc",
          "employees"
        ],
        "type": "object",
        "properties": {
          "today": {
            "type": "string",
            "format": "date"
          },
          "serverNowUtc": {
            "type": "string",
            "format": "date-time"
          },
          "employees": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EmployeeTodayResponse"
            }
          }
        },
        "additionalProperties": false,
        "description": "The whole /list board, with server time for live counters."
      }
    }
  },
  "tags": [
    {
      "name": "Employees"
    },
    {
      "name": "Attendance"
    }
  ]
}