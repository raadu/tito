<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Emit /// comments to XML so they appear as descriptions in the OpenAPI document. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591 = "missing XML comment": don't force docs on every public member. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- Write openapi/v1.json at build time; the Angular app generates its TS client from it. -->
    <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)/../../web/tito-web/openapi</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocumentsOptions>--file-name v1</OpenApiGenerateDocumentsOptions>
  </PropertyGroup>

  <ItemGroup>
    <!-- Registers TitoDbContext with SQL Server + retries, health check and tracing. -->
    <PackageReference Include="Aspire.Microsoft.EntityFrameworkCore.SqlServer" Version="17.0.0" />
    <!-- Generates the OpenAPI document (/openapi/v1.json) from our endpoints. -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
    <PackageReference Include="Scalar.AspNetCore" Version="3.2.0" />
    <!-- Build-time OpenAPI generation (dev-only tool, not shipped with the app). -->
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.15">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tito.ServiceDefaults\Tito.ServiceDefaults.csproj" />
    <ProjectReference Include="..\Tito.Infrastructure\Tito.Infrastructure.csproj" />
  </ItemGroup>

</Project>
