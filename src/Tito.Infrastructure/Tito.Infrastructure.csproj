<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Tito.Core\Tito.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- EF Core provider for SQL Server / Azure SQL. Pinned to 10.x to match .NET 10. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.15" />
    <!-- Used only by the `dotnet ef` tool to create migrations; not shipped with the app. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
